# ==== Azure OpenAI (LLM) ====
AZURE_OPENAI_API_KEY="your-azure-openai-key"
AZURE_OPENAI_ENDPOINT="https://your-azure-openai-resource.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-06-01"
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini" # your deployment name
# ==== Optional: OpenAI Whisper STT (for quick audio transcription) ====
# OPENAI_API_KEY="your-openai-key" # Only if you want audio STT via OpenAI
Whisper
# ==== Optional: ElevenLabs TTS ====
# ELEVENLABS_API_KEY="your-elevenlabs-key"
# ELEVENLABS_VOICE_ID="Rachel" # or a specific voice ID
# ==== App ====
APP_DATA_DIR="./app_data" # where sqlite, faiss, logs will sit
CHECKIN_MINUTES=60 # hourly check-ins
IDLE_SOFT_MIN=20
IDLE_FIRM_MIN=30
IDLE_ENFORCE_MIN=45
DEFAULT_GYM_SLOT="19:00-20:00"
LOCAL_TIMEZONE="Asia/Kolkata"